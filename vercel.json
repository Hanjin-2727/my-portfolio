{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:project(pj[0-9]+|[a-zA-Z0-9_-]+)", "destination": "/:project/index.html" },
    { "source": "/:project(pj[0-9]+|[a-zA-Z0-9_-]+)/", "destination": "/:project/index.html" },
    { "source": "/:project(pj[0-9]+|[a-zA-Z0-9_-]+)/:path*", "destination": "/:project/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
